APP_ENV=development
APP_NAME=Ashlar Advisor
API_PREFIX=/api/v1

# Claude powers HAL's chat/intake/explain layer (the 'first analysis').
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-5
ANTHROPIC_CHAT_MAX_TOKENS=1400
ANTHROPIC_CHAT_TIMEOUT_SECONDS=60

# OpenAI: reserved for the future deep policy-wording comparison feature,
# AND used as an automatic fallback transcription provider if ElevenLabs
# Scribe is unavailable or fails (outage, rate limit, network error).
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_CHAT_MAX_OUTPUT_TOKENS=1400
OPENAI_CHAT_TIMEOUT_SECONDS=60
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ElevenLabs powers voice output (text-to-speech) and is the PRIMARY
# speech-to-text provider (Scribe). VOICE_ID_EN/EL override the default
# per language; at least one voice id must be set for voice output to work.
ELEVENLABS_API_KEY=
ELEVENLABS_TRANSCRIBE_MODEL=scribe_v2
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_EN=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VOICE_ID_EL=
MAX_AUDIO_UPLOAD_MB=20

DATABASE_URL=

# Only used by admin-only endpoints, if/when you add one. With no value set,
# any such endpoint must refuse all requests (fail-closed) — see the audit
# note in core/config.py.
ADMIN_PASSWORD=

# Gmail API lead delivery (OAuth 2.0)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_LEAD_RECIPIENT=

# --- Quote engine business rules -------------------------------------------
# OFF by default. Only turn on after reviewing the discount tiers in
# backend/app/rates/deductible_model.py — no carrier has confirmed these yet.
DEDUCTIBLE_MODEL_ENABLED=false
FAMILY_DISCOUNT_PCT=0.05
QUOTE_VALIDITY_DAYS=30
